# Copy to .env and put your key here. .env is gitignored.
OPENROUTER_API_KEY=sk-or-...

# Dialogue model: the "base LLM" held constant across V1..V4
ALICE_CHAT_MODEL=anthropic/claude-sonnet-5
# Cheap model for extraction, folding, episodes
ALICE_FAST_MODEL=google/gemini-3.5-flash-lite
# Embeddings via OpenRouter; "none" = no vectors (FTS + entities + links only)
ALICE_EMBED_MODEL=baai/bge-m3
# Eval judge only; pick a different family from the chat model
ALICE_JUDGE_MODEL=openai/gpt-5

# Sampling, held constant across versions
ALICE_CHAT_TEMPERATURE=0.7
# ALICE_SEED=42
# Optional OpenRouter provider pin (comma-separated), allow_fallbacks=false
# ALICE_PROVIDER_ORDER=Anthropic

ALICE_DB=data/v1/memory.db
ALICE_SHORT_TERM=12
ALICE_CORE_BUDGET=600
ALICE_RETRIEVAL_BUDGET=1500
ALICE_SESSION_GAP_HOURS=3
# Run extraction inline (1) or in a background worker (0). Eval always runs inline.
# ALICE_SYNC_WRITES=0
# B1 baseline: transcript cap in (estimated) tokens
# ALICE_B1_MAX_TOKENS=150000
